# Copy to .env (NEVER commit). Both API keys required for the live pipeline.

# ── Analyst (Anthropic — Claude Sonnet) ───────────────────────────────
AGENT_PROVIDER_ANALYST=anthropic
ANALYST_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ── Critic (HuggingFace router → DeepSeek V4 Pro via Novita) ─────────
# DeepSeek est un modèle à raisonnement — on désactive reasoning_effort
# pour libérer les tokens de sortie pour le JSON. Si le provider downstream
# ignore ce flag, le FallbackCriticAgent bascule automatiquement sur Gemma.
AGENT_PROVIDER_CRITIC=huggingface
CRITIC_MODEL=deepseek-ai/DeepSeek-V4-Pro:novita
HF_TOKEN=hf_xxxxxxxxxxxx
CRITIC_TEMPERATURE=0

# ── Fallback critic (utilisé si DeepSeek échoue ou laisse trop de PENDING) ──
FALLBACK_CRITIC_MODEL=google/gemma-3-27b-it:novita
FALLBACK_CRITIC_BATCH_SIZE=4

# ── Classifier thresholds (reports/classifier) ───────────────────────
CONFIDENCE_THRESHOLD_CONFIRM=0.75
CONFIDENCE_THRESHOLD_INVESTIGATE=0.50

# ── Misc ─────────────────────────────────────────────────────────────
RESULTS_DIR=./results
SECAUDIT_LOG_LEVEL=INFO
